# Caminho do banco de dados SQLite. Um arquivo unico que pode ser baixado
# e distribuido por qualquer pessoa (ver secao "Baixar o banco" no README).
DATABASE_URL=sqlite:///./prodbr.sqlite3

# Limite maximo de itens retornados por requisicao de busca/listagem.
MAX_PAGE_SIZE=10

# Limites de requisicoes por IP (protecao contra bots/DDoS), formato slowapi.
RATE_LIMIT_READ=60/minute
RATE_LIMIT_WRITE=10/minute
