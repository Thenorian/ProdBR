# Todas as variáveis são opcionais. Sem .env, o ProdBR sobe com estes padrões.

# Banco público (produtos, NCM, fiscal, histórico). Pode ser baixado por qualquer um.
DB_PATH=./data/prodbr.sqlite3

# Banco da comunidade (usuários e tokens). Nunca sai do servidor.
COMMUNITY_DB_PATH=./data/prodbr_community.sqlite3

# Bancos da versão antiga, copiados uma vez para os novos quando eles estão vazios.
LEGACY_PUBLIC_DB_PATH=./data/public.sqlite3
LEGACY_COMMUNITY_DB_PATH=./data/community.sqlite3

# Endereço que o site usa para buscar os dados na API (no servidor, o próprio processo).
API_URL=http://127.0.0.1:8000/api

# Endereço da API usado pelo navegador para salvar alterações.
PUBLIC_API_URL=/api

# Endereço público do site, usado no sitemap. Vazio = lido do próprio acesso.
SITE_URL=

# Anúncio (HTML do provedor, ex: Google AdSense) perto do rodapé. Vazio = sem anúncio.
ADS_SNIPPET=
