# Base publica/distribuivel (produtos, identificadores, fiscal, revisoes).
PUBLIC_DATABASE_URL=sqlite:///./data/public.sqlite3

# Base de comunidade (usuarios, chaves de API, sessoes, moderacao).
# NUNCA e distribuida junto com a base publica.
COMMUNITY_DATABASE_URL=sqlite:///./data/community.sqlite3

# Limite maximo de itens retornados por requisicao de busca/listagem.
MAX_PAGE_SIZE=10

# Limites de requisicoes por IP (protecao contra bots/DDoS), formato slowapi.
RATE_LIMIT_READ=60/minute
RATE_LIMIT_WRITE=10/minute

# Reputacao minima para uma contribuicao ser aplicada direto (sem passar
# pela fila de moderacao).
AUTO_APPROVE_REPUTATION=20
REPUTATION_PER_CREATE=3
REPUTATION_PER_UPDATE=1
REPUTATION_PENALTY_REJECT=2

SESSION_TTL_HOURS=336

# Snippet de anuncio (HTML/JS do seu provedor, ex: Google AdSense) exibido
# num espaco reservado e discreto perto do rodape, em todas as paginas.
# Vazio = nenhum anuncio exibido. Sem painel/admin - so essa variavel.
ADS_SNIPPET=
