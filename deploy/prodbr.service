[Unit]
Description=ProdBR API (FastAPI/uvicorn)
After=network.target

[Service]
# Ajuste User/Group e WorkingDirectory pro seu servidor - deve ser o
# mesmo caminho configurado em DEPLOY_PATH (secret do GitHub Actions).
User=prodbr
Group=prodbr
WorkingDirectory=/opt/prodbr
EnvironmentFile=/opt/prodbr/.env
ExecStart=/opt/prodbr/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
